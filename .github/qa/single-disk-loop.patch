+fn pcss_disk_weights(radius: f32) -> vec3<f32> {
+    return vec3<f32>(1.0, smoothstep(5.0, 12.0, radius), smoothstep(16.0, 32.0, radius));
+}
+
+fn pcss_disk_tap_count(weights: vec3<f32>) -> u32 {
+    return 24u + select(0u, 24u, weights.y > 0.0) + select(0u, 24u, weights.z > 0.0);
